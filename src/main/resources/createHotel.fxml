<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.bookyourstay.controllers.CreateHotelController">
    <Label text="Crear hotel" textAlignment="CENTER">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
    </Label>
   <GridPane prefHeight="179.0" prefWidth="480.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints maxHeight="45" minHeight="10.0" prefHeight="45" vgrow="SOMETIMES" />
       <RowConstraints maxHeight="45" minHeight="10.0" prefHeight="45" vgrow="SOMETIMES" />
         <RowConstraints maxHeight="45.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
      
           <!--Tipo de instalcion-->
           <Label prefHeight="30.0" prefWidth="160.0" text="Seleccione la ciudad" textOverrun="CLIP" wrapText="true" GridPane.rowIndex="1" />
      
          <ComboBox fx:id="comboBoxInstalacion" prefHeight="26.0" prefWidth="195.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <Label text="Ingrese el nombre" />
         <TextField GridPane.columnIndex="1" />
         <Label text="Ingrese la descripcion" GridPane.rowIndex="2" />
         <TextArea prefHeight="78.0" prefWidth="239.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      </children>
      <VBox.margin>
         <Insets bottom="60.0" left="60.0" right="60.0" top="60.0" />
      </VBox.margin>
   </GridPane>
   <Button mnemonicParsing="false" onAction="#createHotel" style="-fx-background-color: #00bf30;" text="Crear hotel" textFill="WHITE">
      <font>
         <Font name="System Bold" size="12.0" />
      </font>
   </Button>

 
</VBox>
