<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.bookyourstay.controllers.CreateHotelController">
    <Label text="Crear hotel" textAlignment="CENTER">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
    </Label>
   <GridPane alignment="CENTER" prefHeight="179.0" prefWidth="480.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints maxHeight="45" minHeight="10.0" prefHeight="45" vgrow="SOMETIMES" />
       <RowConstraints maxHeight="45" minHeight="10.0" prefHeight="45" vgrow="SOMETIMES" />
         <RowConstraints maxHeight="45.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
            <!--Name entry-->
          <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="212.0" text="Ingrese el nombre" />
         <TextField fx:id="txtName" GridPane.columnIndex="1" />
           <!--City selection-->
           <Label alignment="CENTER_RIGHT" prefHeight="30.0" prefWidth="209.0" text="Seleccione la ciudad" textAlignment="RIGHT" textOverrun="CLIP" wrapText="true" GridPane.rowIndex="1" />
          <ComboBox fx:id="comboBoxCities" prefHeight="26.0" prefWidth="195.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
          <!--Enter description-->
          <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="210.0" text="Ingrese la descripcion" GridPane.rowIndex="2" />
         <TextArea fx:id="txtDescription" prefHeight="78.0" prefWidth="239.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      </children>
      <VBox.margin>
         <Insets />
      </VBox.margin>
      <padding>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>
   </GridPane>
   <Button mnemonicParsing="false" onAction="#createHotel" prefHeight="41.0" prefWidth="156.0" style="-fx-background-color: #00bf30;" text="Crear hotel" textFill="WHITE">
      <font>
         <Font name="System Bold" size="20.0" />
      </font>
   </Button>
</VBox>
