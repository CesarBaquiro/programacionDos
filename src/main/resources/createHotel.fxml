<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.bookyourstay.controllers.CreateHotelController">
    <Label text="Crear reservation" textAlignment="CENTER">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
    </Label>
   <GridPane prefHeight="105.0" prefWidth="480.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints maxHeight="45" minHeight="10.0" prefHeight="45" vgrow="SOMETIMES" />
       <RowConstraints maxHeight="45" minHeight="10.0" prefHeight="45" vgrow="SOMETIMES" />
         <RowConstraints maxHeight="45.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
      
           <!--Tipo de instalcion-->
           <Label prefHeight="30.0" prefWidth="160.0" text="Seleccione la instalación" textOverrun="CLIP" wrapText="true" />
      
          <ComboBox fx:id="comboBoxInstalacion" prefHeight="26.0" prefWidth="195.0" GridPane.columnIndex="1" />
         <Label text="Fecha:" GridPane.rowIndex="1" />
         <DatePicker fx:id="txtFecha" prefHeight="26.0" prefWidth="194.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <Button mnemonicParsing="false" onAction="#buscarHorarios" style="-fx-background-color: #00bf30;" text="Buscar schedules" textFill="WHITE" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Button>
      </children>
      <VBox.margin>
         <Insets bottom="60.0" left="60.0" right="60.0" top="60.0" />
      </VBox.margin>
   </GridPane>
   <BorderPane>
      <center>
         <TableView fx:id="tablaHoraios" prefHeight="204.0" prefWidth="579.0">
           <columns>
             <TableColumn fx:id="colDia" prefWidth="75.0" text="Dia" />
             <TableColumn fx:id="colHoraInicio" prefWidth="145.0" text="Hora de inicio" />
               <TableColumn fx:id="colHoraFin" prefWidth="144.60003662109375" text="Hora de fin" />
               <TableColumn fx:id="colAforo" prefWidth="144.60003662109375" text="Aforo" />
               <TableColumn fx:id="reservarBtn" text="Estado" />
           </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </center>
      <VBox.margin>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </VBox.margin>
   </BorderPane>

 
</VBox>
