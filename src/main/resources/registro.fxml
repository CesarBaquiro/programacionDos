<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.reservasuq.controlador.RegistroControlador">

    <Label text="Registro">
        <font>
            <Font size="18.0" />
        </font>
    </Label>


    <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">

        <Label text="Cedula" GridPane.columnIndex="0" />
        <TextField fx:id="txtCedula" minHeight="30.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtNombre" minHeight="30.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Correo electrónico:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtCorreo" minHeight="30.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <PasswordField fx:id="txtPassword" minHeight="30.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints minHeight="10.0" prefHeight="30.0" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" />


      </rowConstraints>
    </GridPane>


    <Button minHeight="40.0" minWidth="130.0" onAction="#registro" text="Registrar" />


</VBox>
